{
  "cases": [
    {
      "id": "default-sandbox-shell",
      "sandbox": "default",
      "expected_cli_exit": 0,
      "prompt": "Use the code-mode shell tool to run exactly `printf DEFAULT_SANDBOX_OK`. Return the output and any tool error. Do not use MCP or edit files.",
      "accepted_fail_closed": {
        "error_contains": "filesystem sandbox cannot be enforced",
        "no_completed_item_types": [
          "command_execution"
        ]
      },
      "expected_items": [
        {
          "type": "command_execution",
          "status": "completed",
          "exit_code": 0,
          "aggregated_output_contains": [
            "DEFAULT_SANDBOX_OK"
          ]
        }
      ],
      "expected_files": {}
    },
    {
      "id": "workspace-write-fail-closed",
      "sandbox": "workspace-write",
      "expected_cli_exit": 0,
      "prompt": "Use the code-mode shell tool to run exactly `touch workspace-write-ran; printf WORKSPACE_WRITE_OK`. Return the output and any tool error. Do not use MCP or edit files another way.",
      "fail_closed_error_contains": "filesystem sandbox cannot be enforced",
      "no_completed_item_types": [
        "command_execution"
      ],
      "expected_files": {}
    },
