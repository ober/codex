        }
      ],
      "expected_files": {}
    },
    {
      "id": "pty-write-stdin",
      "sandbox": "danger-full-access",
      "prompt": "Use a persistent PTY: start `sh -c 'printf \"PTY_READY\\n\"; read input; printf \"PTY_RECEIVED:%s\\n\" \"$input\"'`, then send `hello` through the interactive stdin/write_stdin tool. Return both markers. Do not substitute a one-shot shell command.",
      "expected_items": [
        {
          "type": "command_execution",
          "status": "completed",
          "exit_code": 0,
          "aggregated_output_contains": [
            "PTY_READY\r\nhello\r\n",
            "PTY_RECEIVED:hello"
          ]
        }
      ],
      "expected_files": {},
      "started_item_expectations": [
        {
          "type": "command_execution",
          "command_contains": "read input"
        }
      ]
    },
    {
      "id": "exec-cell-wait",
      "sandbox": "danger-full-access",
      "prompt": "Invoke code-mode exec with exactly this raw JavaScript source (no fences): `// @exec: {\"yield_time_ms\":100}\nconst result = await tools.exec_command({cmd: \"sleep 2; printf WAIT_CELL_OK\"});\ntext(result.output);` Then, because exec must yield before the command finishes, use the returned cell id with wait until completion. Return the final cell output and do not use MCP.",
      "expected_items": [
        {
          "type": "command_execution",
          "status": "completed",
          "exit_code": 0,
          "aggregated_output_contains": [
            "WAIT_CELL_OK"
          ]
        }
      ],
      "expected_files": {}
    },
    {
      "id": "apply-patch",
      "sandbox": "danger-full-access",
      "prompt": "Use apply_patch to create only `patch-marker.txt` in this scratch workspace with exactly `PATCH_APPLIED_OK` followed by a newline. Read it back and report its contents. Do not run shell commands.",
      "expected_items": [
        {
          "type": "file_change",
          "status": "completed",
          "changes": [
            {
              "path": "patch-marker.txt",
              "kind": "add"
            }
          ]
        }
      ],
      "expected_files": {
        "patch-marker.txt": "PATCH_APPLIED_OK\n"
      }
    },
    {
      "id": "parallel-shell",
      "sandbox": "danger-full-access",
      "prompt": "Use code mode to run these two shell commands concurrently and await both. The first command must write exactly A to `a.started`, wait at most two seconds for `b.started`, fail if it never appears, and print PARALLEL_A. The second must write exactly B to `b.started`, wait at most two seconds for `a.started`, fail if it never appears, and print PARALLEL_B. Use shell printf, a short sleep loop, and test; do not run them sequentially and do not use MCP. Report both outputs.",
      "expected_items": [
        {
          "type": "command_execution",
          "status": "completed",
          "exit_code": 0,
          "aggregated_output_contains": [
            "PARALLEL_A"
          ]
        },
        {
          "type": "command_execution",
          "status": "completed",
          "exit_code": 0,
          "aggregated_output_contains": [
            "PARALLEL_B"
          ]
        }
      ],
      "expected_files": {
        "a.started": "A",
        "b.started": "B"
      }
    },
