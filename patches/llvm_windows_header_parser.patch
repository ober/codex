# What: use the Windows CRT APIs in LLVM's header parser host tool.
# Why: the tool is built for and executed on Windows, where MSVC does not
# provide POSIX unistd.h/open/close/execv declarations.

diff --git a/tools/internal/header_parser.c b/tools/internal/header_parser.c
--- a/tools/internal/header_parser.c
+++ b/tools/internal/header_parser.c
@@ -2,7 +2,20 @@
 #include <fcntl.h>
 #include <stdio.h>
 #include <stdlib.h>
 #include <string.h>
+#ifdef _WIN32
+#include <io.h>
+#include <process.h>
+#define close _close
+#define open _open
+#ifndef O_CREAT
+#define O_CREAT _O_CREAT
+#endif
+#ifndef O_WRONLY
+#define O_WRONLY _O_WRONLY
+#endif
+#else
 #include <unistd.h>
+#endif
 
 int main(int argc, char **argv) {
@@ -33,4 +46,8 @@
   argv[0] = (char *)clang_path;
-  execv(clang_path, argv);
+#ifdef _WIN32
+  _execv(clang_path, (const char *const *)argv);
+#else
+  execv(clang_path, argv);
+#endif
   fprintf(stderr, "header_parser: execv failed: %s\n", strerror(errno));
   return 2;
